# Lookz
font-family = 0xProto Nerd Font
font-feature = +calt, +liga, +dlig

theme = Kanso Zen


# Bindings
keybind = global:alt+t=toggle_quick_terminal
keybind = ctrl+backspace=text:\x17
keybind = ctrl+delete=esc:d
keybind = ctrl+enter=unbind
keybind = super+shift+enter=new_window
keybind = performable:ctrl+page_up=scroll_page_up
keybind = performable:ctrl+page_down=scroll_page_down

font-size = 12.5

# Config-options
copy-on-select = clipboard
window-inherit-working-directory = true
### Default keybinds:
# Reload config: C-S-,
